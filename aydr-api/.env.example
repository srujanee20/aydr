# Server Configuration
PORT=8000
NODE_ENV=example

# Database
# If not provided, Mongoose will throw an error. A local or Atlas URI is required.
MONGO_URI=mongodb://127.0.0.1:27017/aydr

# JWT Authentication
# Replace with a strong, randomized string in production
JWT_SECRET=your_temporary_jwt_secret
JWT_EXPIRES_IN=24h
JWT_ISSUER=aydr-api
JWT_AUDIENCE=aydr-client

# Session Authentication (Admin Portal)
SESSION_SECRET=super_secret_admin_key

# ImageKit Configuration (File Uploads)
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint
