<%- include('../partials/header') %>

<h2 class="page-title mb-1">Dashboard Overview</h2>
<p class="text-muted mb-4">Welcome to the Aydr admin panel</p>

<div class="row g-4 mt-1">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:48px;height:48px;background:rgba(245,158,11,0.12)">
                    <i class="fas fa-clock" style="color:#f59e0b;font-size:1.1rem"></i>
                </div>
                <div>
                    <p class="mb-0 text-muted" style="font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:0.03em">Pending Providers</p>
                    <h3 class="mb-0 fw-bold"><%= pendingProviders %></h3>
                </div>
            </div>
            <a href="/admin/providers?status=PENDING" class="d-block text-center py-2 text-decoration-none fw-bold" style="background:rgba(245,158,11,0.06);color:#f59e0b;font-size:0.8rem;border-top:1px solid rgba(245,158,11,0.1)">
                Review Now <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:48px;height:48px;background:rgba(37,99,235,0.1)">
                    <i class="fas fa-calendar-check" style="color:#2563eb;font-size:1.1rem"></i>
                </div>
                <div>
                    <p class="mb-0 text-muted" style="font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:0.03em">Total Bookings</p>
                    <h3 class="mb-0 fw-bold"><%= totalBookings %></h3>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
