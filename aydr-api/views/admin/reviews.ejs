<%- include('../partials/header', { script: '/js/reviews.js' }) %>

<h2 class="page-title mb-1">Moderate Reviews</h2>
<p class="text-muted mb-4" style="font-size:0.85rem">Monitor and remove inappropriate reviews</p>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Date</th>
                    <th>Customer</th>
                    <th>Provider</th>
                    <th>Rating</th>
                    <th>Comment</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (reviews.length === 0) { %>
                <tr>
                    <td colspan="6" class="text-center text-muted py-5">
                        <i class="fas fa-star mb-2" style="font-size:1.5rem;display:block;opacity:0.4"></i>
                        No reviews to moderate.
                    </td>
                </tr>
                <% } %>
                <% reviews.forEach(r => { %>
                <tr class="align-middle">
                    <td class="ps-4 text-muted" style="font-size:0.8rem"><%= new Date(r.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></td>
                    <td class="fw-bold"><%= r.customerId ? r.customerId.name : 'Unknown' %></td>
                    <td><span class="badge" style="background:rgba(37,99,235,0.1);color:#2563eb"><%= r.providerId ? r.providerId.name : 'Unknown' %></span></td>
                    <td>
                        <div class="d-flex align-items-center gap-1">
                            <% for (let i = 1; i <= 5; i++) { %>
                                <i class="fas fa-star <%= i <= r.rating ? 'star-active' : 'star-inactive' %>" style="font-size: 0.7rem;"></i>
                            <% } %>
                            <span class="fw-bold ms-1" style="font-size:0.85rem"><%= r.rating %></span>
                        </div>
                    </td>
                    <td style="max-width:280px" class="text-truncate text-muted" title="<%= r.comment %>"><%= r.comment %></td>
                    <td class="text-end pe-4">
                        <button class="btn btn-sm btn-outline-danger delete-btn" style="border-radius:6px" data-id="<%= r._id %>">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
